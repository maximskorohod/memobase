    {
      "id": "el-6",
      "type": "text",
      "x": 154,
      "y": 255,
      "width": 332,
      "height": 262,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
